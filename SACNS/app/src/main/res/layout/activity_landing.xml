<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Main Blue Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/landingCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#125A87"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Graduation Icon -->
            <ImageView
                android:id="@+id/ivLandingGraduationCap"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/circle_blue"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_graduation_cap"
                app:tint="@color/white"
                android:contentDescription="Graduation Cap" />

            <!-- System Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Smart Admission and Campus Navigation System"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Choose your role to access the system"
                android:textColor="#EAF4FA"
                android:textSize="16sp" />

            <!-- Prospective Student -->
            <Button
                android:id="@+id/btnLandingProspective"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3477A5"
                android:text="Prospective Student"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Current Student -->
            <Button
                android:id="@+id/btnLandingCurrent"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#3477A5"
                android:text="Current Student"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Administrator -->
            <Button
                android:id="@+id/btnLandingAdmin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="#3477A5"
                android:text="Administrator"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>