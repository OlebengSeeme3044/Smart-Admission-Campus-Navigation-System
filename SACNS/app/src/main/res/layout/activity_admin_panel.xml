<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Outer Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Blue Header Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/spu_banner_blue"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Back to Dashboard Button -->
                            <ImageButton
                                android:id="@+id/btnAdminBack"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/circle_blue"
                                android:src="@android:drawable/ic_menu_revert"
                                app:tint="@color/white"
                                android:contentDescription="Back"
                                android:layout_marginEnd="10dp" />

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/circle_blue"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_admin_settings"
                                app:tint="@color/white"
                                android:contentDescription="Admin Control Panel"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Admin Control Panel"
                                    android:textColor="@color/white"
                                    android:textSize="19sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Manage programmes, APS thresholds, and campus data"
                                    android:textColor="#CBD5E1"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Reset Seed Data Button -->
                            <Button
                                android:id="@+id/btnAdminResetData"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:backgroundTint="#30FFFFFF"
                                android:text="Reset Data"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp" />

                        </LinearLayout>

                        <!-- Live Analytics Statistics Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp"
                            android:background="#1AFFFFFF"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAdminStatTotalProgs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="8"
                                    android:textColor="@color/white"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Programmes"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="#40FFFFFF" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAdminStatAvgAps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="32"
                                    android:textColor="@color/white"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Avg Min APS"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="#40FFFFFF" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAdminStatTotalBuildings"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="6"
                                    android:textColor="@color/white"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Venues"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Sub Tabs: Manage Programmes | Manage Campus Data -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayoutAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabIndicatorColor="@color/spu_navy"
                        app:tabIndicatorHeight="3dp"
                        app:tabSelectedTextColor="@color/spu_navy"
                        app:tabTextColor="@color/text_muted">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Programmes" />

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Campus Data" />
                    </com.google.android.material.tabs.TabLayout>

                    <!-- Content Panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Top Row: Add Button + Search Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <Button
                                android:id="@+id/btnAdminAddAction"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:backgroundTint="@color/spu_navy"
                                android:text="+ Add New Programme"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="10dp" />

                            <EditText
                                android:id="@+id/etAdminSearch"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:drawableStart="@drawable/ic_search"
                                android:drawablePadding="8dp"
                                android:hint="Filter..."
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <!-- Add/Edit Form Card (Collapsible) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardAdminForm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:visibility="gone"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#F8FAFC">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvAdminFormTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Add New Programme"
                                    android:textColor="@color/spu_navy"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="14dp" />

                                <!-- Field 1: Name -->
                                <TextView
                                    android:id="@+id/labelField1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Programme Name"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp" />

                                <EditText
                                    android:id="@+id/etAdminField1"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_field"
                                    android:hint="e.g., Diploma in ICT"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:layout_marginBottom="12dp" />

                                <!-- Field 2: Department / Building Type -->
                                <TextView
                                    android:id="@+id/labelField2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Department / Faculty"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp" />

                                <EditText
                                    android:id="@+id/etAdminField2"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_input_field"
                                    android:hint="e.g., Faculty of Humanities"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textSize="14sp"
                                    android:layout_marginBottom="12dp" />

                                <!-- Field 3: Minimum APS / Coordinates -->
                                <LinearLayout
                                    android:id="@+id/layoutAdminFields3and4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:id="@+id/layoutField3Wrapper"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_marginEnd="8dp">

                                        <TextView
                                            android:id="@+id/labelField3"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Minimum APS"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:layout_marginBottom="4dp" />

                                        <EditText
                                            android:id="@+id/etAdminField3"
                                            android:layout_width="match_parent"
                                            android:layout_height="44dp"
                                            android:background="@drawable/bg_input_field"
                                            android:hint="e.g., 28"
                                            android:inputType="number"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:textSize="14sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/layoutField4Wrapper"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical"
                                        android:layout_marginStart="8dp">

                                        <TextView
                                            android:id="@+id/labelField4"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Duration"
                                            android:textColor="@color/text_secondary"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:layout_marginBottom="4dp" />

                                        <EditText
                                            android:id="@+id/etAdminField4"
                                            android:layout_width="match_parent"
                                            android:layout_height="44dp"
                                            android:background="@drawable/bg_input_field"
                                            android:hint="e.g., 3 years"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:textSize="14sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- Form Actions: Save & Cancel -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="end"
                                    android:layout_marginTop="16dp">

                                    <Button
                                        android:id="@+id/btnAdminCancel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="42dp"
                                        android:backgroundTint="#E2E8F0"
                                        android:text="Cancel"
                                        android:textAllCaps="false"
                                        android:textColor="#334155"
                                        android:textSize="13sp"
                                        app:cornerRadius="6dp"
                                        android:layout_marginEnd="8dp" />

                                    <Button
                                        android:id="@+id/btnAdminSave"
                                        android:layout_width="wrap_content"
                                        android:layout_height="42dp"
                                        android:backgroundTint="@color/green_base"
                                        android:text="Save"
                                        android:textAllCaps="false"
                                        android:textColor="@color/white"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        app:cornerRadius="6dp" />
                                </LinearLayout>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Table Header (Dynamic Labels) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="#F8FAFC"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/tvAdminCol1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2.2"
                                android:text="Programme Name"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminCol2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2.2"
                                android:text="Department"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminCol3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Min APS"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminCol4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Duration"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAdminCol5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:text="Actions"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- RecyclerView for Admin Table Items -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminTable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
