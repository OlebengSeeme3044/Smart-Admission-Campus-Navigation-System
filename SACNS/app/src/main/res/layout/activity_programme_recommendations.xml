<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Outer Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Banner Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/spu_banner_blue"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Back Navigation -->
                            <ImageButton
                                android:id="@+id/btnRecsBack"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/circle_blue"
                                android:src="@android:drawable/ic_menu_revert"
                                app:tint="@color/white"
                                android:contentDescription="Back"
                                android:layout_marginEnd="10dp" />

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/circle_blue"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_graduation_cap"
                                app:tint="@color/white"
                                android:contentDescription="Programme Recommendations"
                                android:layout_marginEnd="12dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Programme Recommendations"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvApsCaption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Based on your APS score of 35 points"
                                    android:textColor="#CBD5E1"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- First-Time User Help / Guide Button -->
                            <Button
                                android:id="@+id/btnRecsHelp"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:backgroundTint="#30FFFFFF"
                                android:text="APS Guide"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp" />

                        </LinearLayout>

                        <!-- Interactive APS Adjuster Slider -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp"
                            android:background="#20FFFFFF"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adjust APS: "
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <SeekBar
                                android:id="@+id/sbApsScore"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="50"
                                android:min="15"
                                android:progress="35"
                                android:progressTint="@color/white"
                                android:thumbTint="@color/white" />

                            <TextView
                                android:id="@+id/tvSliderApsVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35"
                                android:textColor="@color/spu_navy"
                                android:textStyle="bold"
                                android:background="@color/white"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 3 Status Summary Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="12dp">

                        <!-- 1. Qualified Card (Green) -->
                        <LinearLayout
                            android:id="@+id/cardQualified"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_status_qualified"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/green_base"
                                android:contentDescription="Qualified" />

                            <TextView
                                android:id="@+id/tvCountQualified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@color/green_text"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Qualified"
                                android:textColor="@color/green_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 2. Borderline Card (Amber) -->
                        <LinearLayout
                            android:id="@+id/cardBorderline"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_status_borderline"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_warning_circle"
                                app:tint="@color/amber_base"
                                android:contentDescription="Borderline" />

                            <TextView
                                android:id="@+id/tvCountBorderline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textColor="@color/amber_text"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Borderline"
                                android:textColor="@color/amber_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 3. Not Eligible Card (Red) -->
                        <LinearLayout
                            android:id="@+id/cardIneligible"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_status_ineligible"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_cancel_circle"
                                app:tint="@color/red_base"
                                android:contentDescription="Not Eligible" />

                            <TextView
                                android:id="@+id/tvCountIneligible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="@color/red_text"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Not Eligible"
                                android:textColor="@color/red_text"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Filter Chips Row -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/chipFilterAll"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:backgroundTint="@color/spu_navy"
                                android:text="All Programmes (8)"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chipFilterQualified"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:backgroundTint="#F1F5F9"
                                android:text="Qualified (5)"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chipFilterBorderline"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:backgroundTint="#F1F5F9"
                                android:text="Borderline (2)"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/chipFilterIneligible"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:backgroundTint="#F1F5F9"
                                android:text="Not Eligible (1)"
                                android:textAllCaps="false"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Search / Keyword Filter Box -->
                    <EditText
                        android:id="@+id/etSearchRecs"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="10dp"
                        android:hint="Filter by name, subject, or faculty..."
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="13sp" />

                    <!-- RecyclerView for Recommended Programme Cards -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProgrammeRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="20dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
