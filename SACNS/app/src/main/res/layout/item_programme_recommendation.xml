<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardProgrammeRec"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/green_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRecProgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diploma in ICT"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecProgDept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Faculty of Humanities • 3 years"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Min APS Pill -->
            <TextView
                android:id="@+id/tvRecMinAps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Min APS: 28"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Your APS Pill -->
            <TextView
                android:id="@+id/tvRecYourAps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E0F2FE"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Your APS: 35"
                android:textColor="#0369A1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Status Badge (Qualified / Borderline / Not Eligible) -->
            <TextView
                android:id="@+id/tvRecStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="QUALIFIED"
                android:textColor="@color/green_text"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
