<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SACNS">

        <!-- Role Landing Activity -->
        <!-- Role Landing Activity -->
        <activity
            android:name=".activities.LandingActivity"
            android:exported="true"/>





        <!-- User Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- Admin Control Panel Activity -->
        <activity
            android:name=".activities.AdminPanelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:label="Admin Panel" />

        <!-- Programme Recommendations Activity -->
        <activity
            android:name=".activities.ProgrammeRecommendationsActivity"
            android:exported="false"
            android:label="Programme Recommendations" />

        <!-- APS Calculator Activity -->
        <activity
            android:name=".activities.ApsCalculatorActivity"
            android:exported="false"
            android:label="APS Calculator" />

        <!-- Campus Navigation & Route Finder Activity -->
        <activity
            android:name=".activities.CampusNavigationActivity"
            android:exported="true"
            android:label="Campus Navigation">


            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>



</manifest>